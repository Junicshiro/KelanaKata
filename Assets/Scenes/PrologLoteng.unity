  m_Script: {fileID: 11500000, guid: 00da306013a1f274591b592d9b0a4c08, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  daftarDialogProlog:
  - namaKarakter: Player
    kalimat: Berdebu sekali di sini. Eh, buku apa ini?
  - namaKarakter: Kamus Ajaib
    kalimat: Wahai anak muda tolonglah aku!
  - namaKarakter: Player
    kalimat: Hah siapa itu yang meminta tolong?
  - namaKarakter: Kamus Ajaib
    kalimat: Aku kamus ajaib, akulah yang meminta tolong
  - namaKarakter: Kamus Ajaib
    kalimat: Kosakata yang ada padaku sudah dicuri
  - namaKarakter: Kamus Ajaib
    kalimat: Bantulah aku mengumpulkan kembali kata - kata untuk mengalahkan dia
  - namaKarakter: Kamus Ajaib
    kalimat: Jika tidak, maka dia akan menghancurkan tempat ini!
  - namaKarakter: Player
    kalimat: Apa!? Baiklah aku akan membantumu
  - namaKarakter: Kamus Ajaib
    kalimat: Untuk mengumpulkan kata - kata, kamu bisa berinteraksi dengan objek
      sekitar
  - namaKarakter: Kamus Ajaib
    kalimat: Dan berinteraksi dengan orang lain
  jedaSebelumDialog: 1.2
